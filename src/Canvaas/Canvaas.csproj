<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Canvaas</AssemblyName>
    <RootNamespace>Canvaas</RootNamespace>
    <Version>0.3.2</Version>
    <Product>Canvaas</Product>
    <Company>Canvaas</Company>
    <ApplicationIcon>canvaas-icon.ico</ApplicationIcon>
  </PropertyGroup>

<ItemGroup>
    <Resource Include="crumpled.jpg" />
    <Resource Include="canvaas-icon.ico" />
  </ItemGroup>
</Project>
