<Window x:Class="Canvaas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Canvaas"
        Width="900"
        Height="600"
        WindowStartupLocation="CenterScreen"
        Background="White">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Canvaas"
                       FontSize="56"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Phase 0: the app builds and starts."
                       FontSize="18"
                       Margin="0,12,0,0"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="VersionText"
                       FontSize="14"
                       Foreground="Gray"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
