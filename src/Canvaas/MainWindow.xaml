<Window x:Class="Canvaas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Untitled - Canvaas"
        Width="1280" Height="800" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        WindowStyle="None" Background="#E6E6E6"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Closing="Window_Closing"
        PreviewMouseUp="Window_PreviewMouseUp"
        PreviewKeyDown="Window_PreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome x:Name="AppWindowChrome" CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ToolIconRadio" TargetType="RadioButton">
            <Setter Property="Width" Value="42"/><Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="2,0"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="18"/><Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#EEEEEE"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#DCE9F9"/>
                            <Setter Property="Foreground" Value="#1A73E8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolIconButton" TargetType="Button">
            <Setter Property="Width" Value="42"/><Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="2,0"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="18"/><Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#EEEEEE"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#DCDCDC"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#BBBBBB"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EdgeAddButton" TargetType="Button">
            <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#1A73E8"/><Setter Property="Background" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="15" BorderBrush="#1A73E8" BorderThickness="1.4"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1A73E8"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuickColorButton" TargetType="Button">
            <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="4"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="Bd" Fill="{TemplateBinding Background}" Stroke="#D0D0D0" StrokeThickness="1.5"/>
                        <Ellipse x:Name="Hover" Stroke="#1A73E8" StrokeThickness="2.5" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SelActionButton" TargetType="Button">
            <Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="1,0"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/><Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#F0F0F0"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E0E0E0"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorSwatch" TargetType="RadioButton">
            <Setter Property="Width" Value="42"/><Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="SwatchBorder" Background="{TemplateBinding Background}" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="6"/>
                        <Border x:Name="SelectionRing" BorderBrush="#1A73E8" BorderThickness="2" CornerRadius="7" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="SelectionRing" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SelectionRing" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="SelectionRing" Property="BorderBrush" Value="#88BBEE"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PopupSwatchButton" TargetType="Button">
            <Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="17" BorderBrush="#CCCCCC" BorderThickness="1"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#1A73E8"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TemplateThumb" TargetType="RadioButton">
            <Setter Property="Width" Value="60"/><Setter Property="Height" Value="78"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="ThumbBorder" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Background="{TemplateBinding Background}"/>
                        <Border x:Name="SelectionRing" BorderBrush="#1A73E8" BorderThickness="2" CornerRadius="5" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="SelectionRing" Property="Visibility" Value="Visible"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PaperThumb" TargetType="RadioButton">
            <Setter Property="Width" Value="92"/><Setter Property="Height" Value="90"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="ThumbBorder" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Background="{TemplateBinding Background}"/>
                        <Border x:Name="SelectionRing" BorderBrush="#1A73E8" BorderThickness="2" CornerRadius="5" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="SelectionRing" Property="Visibility" Value="Visible"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="46"/><Setter Property="Height" Value="36"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E81123"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuFlyoutButton" TargetType="Button">
            <Setter Property="Height" Value="42"/><Setter Property="Padding" Value="16,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#F0F0F0"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E0E0E0"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <!-- ===== New light toolbar styles ===== -->
        <Style x:Key="TopIconButton" TargetType="Button">
            <Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="2,0"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="18"/><Setter Property="Foreground" Value="#222222"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#40808080"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#60808080"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#A0A0A0"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavIconButton" TargetType="Button" BasedOn="{StaticResource TopIconButton}">
            <Setter Property="Width" Value="36"/><Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0"/><Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="TopToolRadio" TargetType="RadioButton">
            <Setter Property="Width" Value="40"/><Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="2,0"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="18"/><Setter Property="Foreground" Value="#222222"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="RadioButton">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="2"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0"/>
                        <TextBlock x:Name="Chevron" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="7"
                                   Foreground="#1A73E8" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                   Margin="0,0,0,4" Visibility="Collapsed"/>
                        <Rectangle x:Name="Underline" Height="2" Fill="#1A73E8" VerticalAlignment="Bottom" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#40808080"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Underline" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Chevron" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarColorDot" TargetType="Button">
            <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="4,0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#BBBBBB"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14"/>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LightTitleButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#D0D0D0"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LightTitleCloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuickColorSquare" TargetType="Button">
            <Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="2"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="#BBBBBB"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"/>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>

        <DrawingBrush x:Key="PreviewBlank" TileMode="None">
            <DrawingBrush.Drawing><GeometryDrawing Brush="White"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,60,78"/></GeometryDrawing.Geometry></GeometryDrawing></DrawingBrush.Drawing>
        </DrawingBrush>
        <DrawingBrush x:Key="PreviewRuled" TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute">
            <DrawingBrush.Drawing><DrawingGroup>
                <GeometryDrawing Brush="White"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,10,10"/></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Pen><Pen Brush="#888888" Thickness="0.5"/></GeometryDrawing.Pen>
                <GeometryDrawing.Geometry><LineGeometry StartPoint="0,9.75" EndPoint="10,9.75"/></GeometryDrawing.Geometry></GeometryDrawing>
            </DrawingGroup></DrawingBrush.Drawing>
        </DrawingBrush>
        <DrawingBrush x:Key="PreviewGrid" TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute">
            <DrawingBrush.Drawing><DrawingGroup>
                <GeometryDrawing Brush="White"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,10,10"/></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Pen><Pen Brush="#888888" Thickness="0.5"/></GeometryDrawing.Pen>
                <GeometryDrawing.Geometry><GeometryGroup>
                    <LineGeometry StartPoint="0,9.75" EndPoint="10,9.75"/>
                    <LineGeometry StartPoint="9.75,0" EndPoint="9.75,10"/>
                </GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
            </DrawingGroup></DrawingBrush.Drawing>
        </DrawingBrush>
        <DrawingBrush x:Key="PreviewDot" TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute">
            <DrawingBrush.Drawing><DrawingGroup>
                <GeometryDrawing Brush="White"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,10,10"/></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing Brush="#888888"><GeometryDrawing.Geometry><EllipseGeometry Center="5,5" RadiusX="1" RadiusY="1"/></GeometryDrawing.Geometry></GeometryDrawing>
            </DrawingGroup></DrawingBrush.Drawing>
        </DrawingBrush>
        <DrawingBrush x:Key="PreviewPaperWhite" TileMode="None">
            <DrawingBrush.Drawing><GeometryDrawing Brush="#FFFFFF"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,92,90"/></GeometryDrawing.Geometry></GeometryDrawing></DrawingBrush.Drawing>
        </DrawingBrush>
        <DrawingBrush x:Key="PreviewPaperCrumpled" TileMode="Tile" Viewport="0,0,30,30" ViewportUnits="Absolute">
            <DrawingBrush.Drawing><DrawingGroup>
                <GeometryDrawing Brush="#FCFCFA"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,30,30"/></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing><GeometryDrawing.Pen><Pen Brush="#D8D8D2" Thickness="0.7"/></GeometryDrawing.Pen>
                <GeometryDrawing.Geometry><GeometryGroup>
                    <LineGeometry StartPoint="0,6" EndPoint="18,14"/>
                    <LineGeometry StartPoint="6,0" EndPoint="24,30"/>
                    <LineGeometry StartPoint="0,22" EndPoint="30,18"/>
                    <LineGeometry StartPoint="14,0" EndPoint="26,30"/>
                    <LineGeometry StartPoint="0,28" EndPoint="30,26"/>
                    <LineGeometry StartPoint="22,0" EndPoint="30,12"/>
                </GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
            </DrawingGroup></DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New" Executed="New_Executed"/>
        <CommandBinding Command="ApplicationCommands.Open" Executed="Open_Executed"/>
        <CommandBinding Command="ApplicationCommands.Save" Executed="Save_Executed"/>
        <CommandBinding Command="ApplicationCommands.SaveAs" Executed="SaveAs_Executed"/>
        <CommandBinding Command="ApplicationCommands.Undo" Executed="Undo_Executed" CanExecute="Undo_CanExecute"/>
        <CommandBinding Command="ApplicationCommands.Redo" Executed="Redo_Executed" CanExecute="Redo_CanExecute"/>
        <CommandBinding Command="ApplicationCommands.SelectAll" Executed="SelectAll_Executed"/>
    </Window.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Title bar (light) ===== -->
        <Border x:Name="TitleBarBorder" Grid.Row="0" Background="#E6E6E6" Height="36">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="MinimizeButton" Style="{StaticResource LightTitleButton}" Content="&#xE921;" ToolTip="Minimize" Click="MinimizeButton_Click"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource LightTitleButton}" Content="&#xE922;" ToolTip="Maximize" Click="MaximizeButton_Click"/>
                    <Button x:Name="CloseButton" Style="{StaticResource LightTitleCloseButton}" Content="&#xE8BB;" ToolTip="Close" Click="CloseButton_Click"/>
                </StackPanel>
                <Button x:Name="ChromeToggleButton" DockPanel.Dock="Left" Style="{StaticResource LightTitleButton}"
                        Content="&#xE70E;" ToolTip="Show / hide toolbar (Tab)" Click="ChromeToggleButton_Click"/>
                <TextBlock x:Name="TitleBarText" Foreground="#333333" FontSize="12"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
            </DockPanel>
        </Border>

        <!-- ===== Top toolbar (light) ===== -->
        <Border x:Name="TopToolbarBorder" Grid.Row="1" Background="#E6E6E6"
                BorderBrush="#D0D0D0" BorderThickness="0,0,0,1" Height="48">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MenuButton" Style="{StaticResource TopIconButton}" Content="&#xE700;" ToolTip="Menu" Click="MenuButton_Click"/>
                    <Button x:Name="FullscreenButton" Style="{StaticResource TopIconButton}" Content="&#xE740;" ToolTip="Fullscreen (F11)" Click="FullscreenButton_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <RadioButton x:Name="PenButton" Style="{StaticResource TopToolRadio}" GroupName="Tools" Content="&#xE70F;" ToolTip="Pen (1)" Click="PenButton_Click"/>
                    <RadioButton x:Name="HighlighterButton" Style="{StaticResource TopToolRadio}" GroupName="Tools" Content="&#xE7E6;" ToolTip="Highlighter (2)" Click="HighlighterButton_Click"/>
                    <RadioButton x:Name="CalligraphyButton" Style="{StaticResource TopToolRadio}" GroupName="Tools" Content="✒" FontFamily="Segoe UI Symbol" FontSize="17" ToolTip="Calligraphy pen" Click="CalligraphyButton_Click"/>
                    <RadioButton x:Name="EraserButton" Style="{StaticResource TopToolRadio}" GroupName="Tools" Content="&#xE75C;" ToolTip="Eraser (3)" Click="EraserButton_Click"/>
                    <RadioButton x:Name="LassoButton" Style="{StaticResource TopToolRadio}" GroupName="Tools" Content="&#xE75D;" ToolTip="Lasso (4)" Click="LassoButton_Click"/>
                    <RadioButton x:Name="HandButton" Style="{StaticResource TopToolRadio}" GroupName="Tools" Content="✋" FontFamily="Segoe UI Emoji" FontSize="16" ToolTip="Pan (5)" Click="HandButton_Click"/>

                    <Rectangle Width="1" Height="24" Margin="12,0" Fill="#9A9A9A"/>

                    <Button x:Name="AddMenuButton" Style="{StaticResource TopIconButton}" Content="&#xE710;" ToolTip="Insert / paste" Click="MenuButton2_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Insert Image…" Click="InsertImage_Click"/>
                                <MenuItem Header="Insert PDF…" Click="ImportPdf_Click"/>
                                <MenuItem Header="Insert Text…" Click="InsertText_Click"/>
                                <Separator/>
                                <MenuItem Header="Paste Image from Clipboard" Click="PasteClipboardImage_Click"/>
                                <MenuItem Header="Paste Text from Clipboard" Click="PasteClipboardText_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="AddPageButton" Style="{StaticResource TopIconButton}" Content="&#xE7C3;" ToolTip="Add / delete page" Click="AddPageButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Add a new notebook page" Click="NewNotebookPage_Click"/>
                                <MenuItem Header="Delete this notebook page" Click="DeletePageButton_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="SaveMenuButton" Style="{StaticResource TopIconButton}" Content="&#xE74E;" ToolTip="File menu" Click="MenuButton2_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="New" Command="ApplicationCommands.New"/>
                                <MenuItem Header="Open..." Command="ApplicationCommands.Open"/>
                                <Separator/>
                                <MenuItem Header="Save" Command="ApplicationCommands.Save"/>
                                <MenuItem Header="Save As..." Command="ApplicationCommands.SaveAs"/>
                                <Separator/>
                                <MenuItem Header="Export current page as PNG…" Click="ExportCurrentPagePng_Click"/>
                                <MenuItem Header="Export all pages as PNG…" Click="ExportAllPagesPng_Click"/>
                                <MenuItem Header="Export as PDF…" Click="ExportAsPdf_Click"/>
                                <Separator/>
                                <MenuItem Header="Delete current page" Click="DeletePageButton_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="ClearButton" Style="{StaticResource TopIconButton}" Content="&#xE74D;" ToolTip="Clear page" Click="ClearButton_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UndoButton" Style="{StaticResource TopIconButton}" Content="&#xE7A7;" ToolTip="Undo (Ctrl+Z)" Command="ApplicationCommands.Undo"/>
                    <Button x:Name="RedoButton" Style="{StaticResource TopIconButton}" Content="&#xE7A6;" ToolTip="Redo (Ctrl+Y)" Command="ApplicationCommands.Redo"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Border x:Name="CanvasHostBorder" Background="#E6E6E6" ClipToBounds="True"
                    PreviewMouseDown="CanvasHostBorder_PreviewMouseDown"
                    PreviewMouseMove="CanvasHostBorder_PreviewMouseMove"
                    PreviewMouseUp="CanvasHostBorder_PreviewMouseUp"
                    PreviewMouseWheel="CanvasHostBorder_PreviewMouseWheel">
                <Canvas x:Name="CanvasHost" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0,0">
                    <Canvas.RenderTransform>
                        <MatrixTransform x:Name="ViewTransform"/>
                    </Canvas.RenderTransform>
                    <Rectangle x:Name="PageBackground" Canvas.Left="0" Canvas.Top="0" Fill="White" IsHitTestVisible="False"/>
                    <InkCanvas x:Name="InkArea" Canvas.Left="0" Canvas.Top="0" Background="Transparent"
                               ForceCursor="True" Stylus.IsPressAndHoldEnabled="False" Stylus.IsFlicksEnabled="False"
                               StylusOutOfRange="InkArea_StylusOutOfRange"
                               StrokeCollected="InkArea_StrokeCollected"
                               SelectionChanged="InkArea_SelectionChanged"/>
                </Canvas>
            </Border>

            <Canvas x:Name="EdgeButtonOverlay" ClipToBounds="True"/>
            <Canvas x:Name="HandleOverlay" ClipToBounds="True"/>

            <Border x:Name="SelectionToolbar" Background="White" BorderBrush="#D0D0D0" BorderThickness="1"
                    CornerRadius="8" Padding="3" Visibility="Collapsed"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="100">
                <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25" Color="Black"/></Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="SelToolDuplicate" Style="{StaticResource SelActionButton}"
                            Content="&#xE8C8;" ToolTip="Duplicate" Click="SelToolDuplicate_Click"/>
                    <Button x:Name="SelToolCopy" Style="{StaticResource SelActionButton}"
                            Content="&#xE8C8;" ToolTip="Copy" Click="SelToolCopy_Click"/>
                    <Button x:Name="SelToolDelete" Style="{StaticResource SelActionButton}"
                            Content="&#xE74D;" ToolTip="Delete" Click="SelToolDelete_Click"/>
                </StackPanel>
            </Border>

            <!-- Floating colour square (drag the thin top strip to move it anywhere) -->
            <Canvas x:Name="ColorSquareHost" ClipToBounds="False" Background="{x:Null}">
                <Border x:Name="ColorSquareRoot" Background="#111111" BorderBrush="#000000" BorderThickness="1"
                        CornerRadius="4" Padding="3">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" Color="Black"/>
                    </Border.Effect>
                    <StackPanel>
                        <Border x:Name="ColorSquareDragHandle" Height="14" Background="#111111" Cursor="SizeAll"
                                MouseLeftButtonDown="ColorSquareDragHandle_MouseDown"
                                MouseMove="ColorSquareDragHandle_MouseMove"
                                MouseLeftButtonUp="ColorSquareDragHandle_MouseUp">
                            <TextBlock Text="&#x2022;&#x2022;&#x2022;" Foreground="#888888" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <UniformGrid Columns="2">
                            <Button x:Name="QuickColor2" Style="{StaticResource QuickColorSquare}" Background="#E53935" Tag="#E53935" Click="QuickColor_Click" ToolTip="Red"/>
                            <Button x:Name="QuickColor1" Style="{StaticResource QuickColorSquare}" Background="#000000" Tag="#000000" Click="QuickColor_Click" ToolTip="Black"/>
                            <Button x:Name="QuickColor3" Style="{StaticResource QuickColorSquare}" Background="#1E88E5" Tag="#1E88E5" Click="QuickColor_Click" ToolTip="Blue"/>
                            <Button x:Name="QuickColor4" Style="{StaticResource QuickColorSquare}" Background="#43A047" Tag="#43A047" Click="QuickColor_Click" ToolTip="Green"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Canvas>

            <!-- ===== Bottom-right page + zoom bar ===== -->
            <Border x:Name="NavBar" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6"
                    Background="#F3F3F3" BorderBrush="#B0B0B0" BorderThickness="1" Panel.ZIndex="90">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="PrevPageButton" Style="{StaticResource NavIconButton}" Content="&#xE72B;" ToolTip="Previous page" Click="PrevPageButton_Click"/>
                    <TextBox x:Name="PageCounterBox" Text="1 / 1" Width="48" BorderThickness="0" Background="Transparent"
                             FontSize="12" Foreground="#222222" VerticalAlignment="Center"
                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                             KeyDown="PageCounterBox_KeyDown" LostFocus="PageCounterBox_LostFocus"/>
                    <Button x:Name="NextPageButton" Style="{StaticResource NavIconButton}" Content="&#xE72A;" ToolTip="Next page" Click="NextPageButton_Click"/>
                    <Rectangle Width="1" Margin="4,4" Fill="#9A9A9A"/>
                    <Button x:Name="ZoomInButton" Style="{StaticResource NavIconButton}" Content="&#xE8A3;" ToolTip="Zoom in" Click="ZoomInButton_Click"/>
                    <Button x:Name="ZoomResetButton" Style="{StaticResource NavIconButton}" Width="60" ToolTip="Reset zoom" Click="ZoomResetButton_Click">
                        <TextBlock x:Name="ZoomText" Text="100%" FontFamily="Segoe UI" FontSize="12" Foreground="#222222"/>
                    </Button>
                    <Button x:Name="ZoomOutButton" Style="{StaticResource NavIconButton}" Content="&#xE71F;" ToolTip="Zoom out" Click="ZoomOutButton_Click"/>
                </StackPanel>
            </Border>

            <Border x:Name="ToastBorder" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,60" Background="#DD222222" CornerRadius="8" Padding="14,8"
                    Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="200">
                <TextBlock x:Name="StatusText" Foreground="White" FontSize="12"/>
            </Border>

            <Border x:Name="MainMenuFlyout" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="6,6,0,0" Width="220" Background="White"
                    BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="8"
                    Visibility="Collapsed" Panel.ZIndex="400">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="4" Opacity="0.22" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <Button Style="{StaticResource MenuFlyoutButton}" Click="OpenSettings_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#555555" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuFlyoutButton}" Click="OpenShortcuts_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#555555" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <TextBlock Text="Shortcuts" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Rectangle Height="1" Fill="#EEEEEE"/>
                    <Button Style="{StaticResource MenuFlyoutButton}" Click="RateThisApp_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#555555" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <TextBlock Text="Rate This App" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuFlyoutButton}" Click="SendFeedback_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#555555" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <TextBlock Text="Send Feedback" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MenuFlyoutButton}" Click="MoreApps_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#555555" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <TextBlock Text="More Apps" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Grid x:Name="SettingsOverlay" Visibility="Collapsed" Panel.ZIndex="500"
                  Background="#AA000000" MouseDown="SettingsOverlay_MouseDown">
                <Border Background="White" Width="640" MaxHeight="760"
                        BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="12"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.35" Color="Black"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#F5F5F5" CornerRadius="12,12,0,0">
                            <DockPanel Margin="20,14">
                                <Button x:Name="CloseSettingsButton" DockPanel.Dock="Right" Width="32" Height="32"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        FontFamily="Segoe MDL2 Assets" Content="&#xE711;" FontSize="14"
                                        Click="CloseSettings_Click"/>
                                <TextBlock x:Name="SettingsTitle" Text="Settings" FontSize="16" FontWeight="SemiBold"
                                           Foreground="#333333" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
                            <StackPanel>
                                <!-- Appearance -->
                                <TextBlock Text="Paper" FontWeight="SemiBold" FontSize="14" Foreground="#333333" Margin="0,0,0,8"/>
                                <UniformGrid Columns="4" Margin="0,0,0,16">
                                    <RadioButton x:Name="PaperWhite" Style="{StaticResource PaperThumb}" GroupName="Paper" Background="{StaticResource PreviewPaperWhite}" ToolTip="Plain white" Click="PaperThumb_Click" Tag="White"/>
                                    <RadioButton x:Name="PaperCrumpled" Style="{StaticResource PaperThumb}" GroupName="Paper" Background="{StaticResource PreviewPaperCrumpled}" ToolTip="Crumpled" Click="PaperThumb_Click" Tag="Crumpled"/>
                                </UniformGrid>

                                <TextBlock Text="Background colour" FontWeight="SemiBold" FontSize="14" Foreground="#333333" Margin="0,0,0,8"/>
                                <UniformGrid Columns="9" Margin="0,0,0,16">
                                    <RadioButton x:Name="ColorWhite" Style="{StaticResource ColorSwatch}" GroupName="BgColor" Background="#FFFFFF" ToolTip="White" Click="ColorSwatch_Click" Tag="#FFFFFF"/>
                                    <RadioButton x:Name="ColorCream" Style="{StaticResource ColorSwatch}" GroupName="BgColor" Background="#FAF6E3" ToolTip="Cream" Click="ColorSwatch_Click" Tag="#FAF6E3"/>
                                    <RadioButton x:Name="ColorLightGray" Style="{StaticResource ColorSwatch}" GroupName="BgColor" Background="#EEEEEE" ToolTip="Light grey" Click="ColorSwatch_Click" Tag="#EEEEEE"/>
                                    <RadioButton x:Name="ColorSage" Style="{StaticResource ColorSwatch}" GroupName="BgColor" Background="#DCE9D5" ToolTip="Sage" Click="ColorSwatch_Click" Tag="#DCE9D5"/>
                                    <RadioButton x:Name="ColorSky" Style="{StaticResource ColorSwatch}" GroupName="BgColor" Background="#DCE4F2" ToolTip="Sky" Click="ColorSwatch_Click" Tag="#DCE4F2"/>
                                    <RadioButton x:Name="ColorNavy" Style="{StaticResource ColorSwatch}" GroupName="BgColor" Background="#2C3E5C" ToolTip="Navy" Click="ColorSwatch_Click" Tag="#2C3E5C"/>
                                    <RadioButton x:Name="ColorDarkGreen" Style="{StaticResource ColorSwatch}" GroupName="BgColor" Background="#1E4D3A" ToolTip="Dark green" Click="ColorSwatch_Click" Tag="#1E4D3A"/>
                                    <RadioButton x:Name="ColorPitch" Style="{StaticResource ColorSwatch}" GroupName="BgColor" Background="#000000" ToolTip="Pitch black" Click="ColorSwatch_Click" Tag="#000000"/>
                                    <RadioButton x:Name="ColorBlack" Style="{StaticResource ColorSwatch}" GroupName="BgColor" Background="#1A1A1A" ToolTip="Black" Click="ColorSwatch_Click" Tag="#1A1A1A"/>
                                </UniformGrid>

                                <TextBlock Text="Templates" FontWeight="SemiBold" FontSize="14" Foreground="#333333" Margin="0,0,0,8"/>
                                <UniformGrid Columns="4" Margin="0,0,0,16">
                                    <RadioButton x:Name="TemplateBlank" Style="{StaticResource TemplateThumb}" GroupName="Template" Background="{StaticResource PreviewBlank}" ToolTip="Blank" Click="TemplateButton_Click" Tag="Blank"/>
                                    <RadioButton x:Name="TemplateRuled" Style="{StaticResource TemplateThumb}" GroupName="Template" Background="{StaticResource PreviewRuled}" ToolTip="Ruled" Click="TemplateButton_Click" Tag="Ruled"/>
                                    <RadioButton x:Name="TemplateGrid" Style="{StaticResource TemplateThumb}" GroupName="Template" Background="{StaticResource PreviewGrid}" ToolTip="Grid" Click="TemplateButton_Click" Tag="Grid"/>
                                    <RadioButton x:Name="TemplateDot" Style="{StaticResource TemplateThumb}" GroupName="Template" Background="{StaticResource PreviewDot}" ToolTip="Dot grid" Click="TemplateButton_Click" Tag="Dot"/>
                                </UniformGrid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Spacing" VerticalAlignment="Center" Foreground="#555555" FontSize="13"/>
                                    <Slider Grid.Column="1" x:Name="SpacingSlider" Minimum="1" Maximum="60" Value="40"
                                            TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            ValueChanged="SpacingSlider_ValueChanged"/>
                                    <TextBlock Grid.Column="2" x:Name="SpacingText" Text="40" TextAlignment="Right"
                                               VerticalAlignment="Center" Foreground="#555555" FontSize="12"/>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Pattern darkness" VerticalAlignment="Center" Foreground="#555555" FontSize="13"/>
                                    <Slider Grid.Column="1" x:Name="PatternOpacitySlider" Minimum="0" Maximum="100" Value="50"
                                            IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                                            ValueChanged="PatternOpacitySlider_ValueChanged"/>
                                    <TextBlock Grid.Column="2" x:Name="PatternOpacityText" Text="50" TextAlignment="Right"
                                               VerticalAlignment="Center" Foreground="#555555" FontSize="12"/>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Line thickness" VerticalAlignment="Center" Foreground="#555555" FontSize="13"/>
                                    <Slider Grid.Column="1" x:Name="PatternThicknessSlider" Minimum="0.5" Maximum="4" Value="1"
                                            IsSnapToTickEnabled="True" TickFrequency="0.5" VerticalAlignment="Center"
                                            ValueChanged="PatternThicknessSlider_ValueChanged"/>
                                    <TextBlock Grid.Column="2" x:Name="PatternThicknessText" Text="1.0" TextAlignment="Right"
                                               VerticalAlignment="Center" Foreground="#555555" FontSize="12"/>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Dot size" VerticalAlignment="Center" Foreground="#555555" FontSize="13"/>
                                    <Slider Grid.Column="1" x:Name="PatternDotSizeSlider" Minimum="0.5" Maximum="4" Value="1.2"
                                            IsSnapToTickEnabled="True" TickFrequency="0.1" VerticalAlignment="Center"
                                            ValueChanged="PatternDotSizeSlider_ValueChanged"/>
                                    <TextBlock Grid.Column="2" x:Name="PatternDotSizeText" Text="1.2" TextAlignment="Right"
                                               VerticalAlignment="Center" Foreground="#555555" FontSize="12"/>
                                </Grid>

                                <Rectangle Height="1" Fill="#EEEEEE" Margin="0,16,0,20"/>

                                <!-- Cursor -->
                                <TextBlock Text="Cursor" FontWeight="SemiBold" FontSize="14" Foreground="#333333" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Cursor style" VerticalAlignment="Center" Foreground="#555555" FontSize="13"/>
                                    <ComboBox Grid.Column="1" x:Name="CursorCombo" Width="220" HorizontalAlignment="Left" SelectedIndex="2" SelectionChanged="CursorCombo_SelectionChanged">
                                        <ComboBoxItem Content="Arrow"/>
                                        <ComboBoxItem Content="Crosshair"/>
                                        <ComboBoxItem Content="Hollow ring + dot"/>
                                        <ComboBoxItem Content="Hidden (use pen tip)"/>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Pointer size" VerticalAlignment="Center" Foreground="#555555" FontSize="13"/>
                                    <Slider Grid.Column="1" x:Name="PointerSizeSlider" Minimum="6" Maximum="32" Value="12"
                                            TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            ValueChanged="PointerSizeSlider_ValueChanged"/>
                                    <TextBlock Grid.Column="2" x:Name="PointerSizeText" Text="12" TextAlignment="Right"
                                               VerticalAlignment="Center" Foreground="#555555" FontSize="12"/>
                                </Grid>

                                <CheckBox x:Name="ShowCursorDotCheck" Content="Show dot in cursor centre" Margin="0,4,0,12"
                                          Foreground="#555555" FontSize="13"
                                          Checked="ShowCursorDotCheck_Changed" Unchecked="ShowCursorDotCheck_Changed"/>

                                <Rectangle Height="1" Fill="#EEEEEE" Margin="0,16,0,20"/>

                                <!-- PDF export -->
                                <TextBlock Text="PDF export" FontWeight="SemiBold" FontSize="14" Foreground="#333333" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Page size" VerticalAlignment="Center" Foreground="#555555" FontSize="13"/>
                                    <ComboBox Grid.Column="1" x:Name="PdfPageSizeCombo" Width="220" HorizontalAlignment="Left" SelectedIndex="0">
                                        <ComboBoxItem Content="A4"/>
                                        <ComboBoxItem Content="Letter"/>
                                        <ComboBoxItem Content="Legal"/>
                                        <ComboBoxItem Content="A3"/>
                                        <ComboBoxItem Content="A5"/>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Orientation" VerticalAlignment="Center" Foreground="#555555" FontSize="13"/>
                                    <ComboBox Grid.Column="1" x:Name="PdfOrientationCombo" Width="220" HorizontalAlignment="Left" SelectedIndex="0">
                                        <ComboBoxItem Content="Portrait"/>
                                        <ComboBoxItem Content="Landscape"/>
                                    </ComboBox>
                                </Grid>

                                <Rectangle Height="1" Fill="#EEEEEE" Margin="0,16,0,20"/>

                                <!-- Shortcuts -->
                                <TextBlock Text="Keyboard shortcuts" FontWeight="SemiBold" FontSize="14" Foreground="#333333" Margin="0,0,0,6"/>
                                <TextBlock Text="Click a button, then press the key you want. Press Esc to cancel."
                                           FontSize="12" Foreground="#777777" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                <ItemsControl x:Name="ShortcutList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="#333333" FontSize="13"/>
                                                <Button Grid.Column="1" Content="{Binding KeyLabel}" MinWidth="100" Height="28"
                                                        Tag="{Binding ActionId}" Click="ShortcutChange_Click"
                                                        FontSize="12" Padding="8,2"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="2" Background="#F5F5F5" CornerRadius="0,0,12,12" BorderBrush="#EEEEEE" BorderThickness="0,1,0,0">
                            <DockPanel Margin="20,12">
                                <Button DockPanel.Dock="Right" Content="Done" MinWidth="90" Height="32"
                                        Click="CloseSettings_Click"/>
                                <Button Content="Reset to defaults" Height="32" Padding="12,2"
                                        HorizontalAlignment="Left" Click="ResetAllSettings_Click"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Popup x:Name="ToolOptionsPopup" Placement="Bottom" StaysOpen="False"
               AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="White" BorderBrush="#D0D0D0" BorderThickness="1"
                    CornerRadius="10" Padding="14,12" Margin="6,4,6,12">
                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.18" Direction="270"/></Border.Effect>
                <StackPanel Width="252">
                    <TextBlock x:Name="ToolPopupTitle" Text="Pen" FontSize="13" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,10"/>
                    <TextBlock Text="Colour" FontSize="11" Foreground="#666666" Margin="0,0,0,6"/>
                    <ItemsControl x:Name="ToolColorGrid">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource PopupSwatchButton}" Tag="{Binding Hex}"
                                        ToolTip="{Binding Name}" Background="{Binding Brush}" Click="ToolColorButton_Click"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Thickness" FontSize="11" Foreground="#666666" Margin="0,14,0,6"/>
                    <Border Background="#FAFAFA" BorderBrush="#E6E6E6" BorderThickness="1" CornerRadius="4" Height="46" Padding="8,0">
                        <Path x:Name="ToolThicknessPreview" HorizontalAlignment="Left" VerticalAlignment="Center"
                              Stroke="#111111" StrokeThickness="2.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M 4,22 C 28,6 50,38 74,20 C 98,2 120,38 144,18 C 168,-2 190,32 214,16 C 222,10 226,14 230,14"/>
                    </Border>
                    <Slider x:Name="ToolSizeSlider" Minimum="1" Maximum="20" Value="2.5"
                            TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,10,0,0"
                            ValueChanged="ToolSizeSlider_ValueChanged"/>
                    <CheckBox x:Name="ToolPressureToggle" Content="Pressure (use pen pressure)"
                              Margin="0,10,0,0" IsChecked="True"
                              Checked="ToolPressureToggle_Changed" Unchecked="ToolPressureToggle_Changed"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
