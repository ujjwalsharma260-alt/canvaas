<Window x:Class="Canvaas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Untitled - Canvaas"
        Width="1100"
        Height="720"
        WindowStartupLocation="CenterScreen"
        Background="#E6E6E6"
        Closing="Window_Closing">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="3"/>
        </Style>
    </Window.Resources>

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New" Executed="New_Executed"/>
        <CommandBinding Command="ApplicationCommands.Open" Executed="Open_Executed"/>
        <CommandBinding Command="ApplicationCommands.Save" Executed="Save_Executed"/>
        <CommandBinding Command="ApplicationCommands.SaveAs" Executed="SaveAs_Executed"/>
        <CommandBinding Command="ApplicationCommands.Undo" Executed="Undo_Executed" CanExecute="Undo_CanExecute"/>
        <CommandBinding Command="ApplicationCommands.Redo" Executed="Redo_Executed" CanExecute="Redo_CanExecute"/>
    </Window.CommandBindings>

    <DockPanel>

        <!-- Top toolbar -->
        <Border DockPanel.Dock="Top" Background="#F7F7F7" BorderBrush="#C8C8C8" BorderThickness="0,0,0,1">
            <WrapPanel Margin="6,4">
                <Button Content="New" Command="ApplicationCommands.New" ToolTip="New blank note (Ctrl+N)"/>
                <Button Content="Open" Command="ApplicationCommands.Open" ToolTip="Open a note (Ctrl+O)"/>
                <Button Content="Save" Command="ApplicationCommands.Save" ToolTip="Save (Ctrl+S)"/>
                <Button Content="Save As" Command="ApplicationCommands.SaveAs" ToolTip="Save as a new file"/>

                <RadioButton x:Name="PenButton" Content="Pen" GroupName="Tools"
                             Style="{StaticResource {x:Type ToggleButton}}"
                             Padding="14,6" Margin="18,3,3,3"
                             ToolTip="Draw with pen or mouse"
                             Click="PenButton_Click"/>
                <RadioButton x:Name="EraserButton" Content="Eraser" GroupName="Tools"
                             Style="{StaticResource {x:Type ToggleButton}}"
                             Padding="14,6" Margin="3"
                             ToolTip="Erase a whole stroke by touching it"
                             Click="EraserButton_Click"/>

                <Button Content="Undo" Command="ApplicationCommands.Undo" Margin="18,3,3,3" ToolTip="Undo (Ctrl+Z)"/>
                <Button Content="Redo" Command="ApplicationCommands.Redo" ToolTip="Redo (Ctrl+Y)"/>
                <Button Content="Clear page" Click="ClearButton_Click" ToolTip="Remove everything on the page"/>
            </WrapPanel>
        </Border>

        <!-- Bottom status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready. Draw with your pen or mouse."/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="VersionText" Foreground="Gray"/>
            </StatusBarItem>
        </StatusBar>

        <!-- The writing page -->
        <Border Margin="12" Background="White" BorderBrush="#B0B0B0" BorderThickness="1">
            <InkCanvas x:Name="InkArea"
                       Background="White"
                       Stylus.IsPressAndHoldEnabled="False"
                       Stylus.IsFlicksEnabled="False"
                       StrokeCollected="InkArea_StrokeCollected"/>
        </Border>

    </DockPanel>
</Window>
