<Window x:Class="Canvaas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Untitled - Canvaas"
        Width="1280"
        Height="800"
        WindowStartupLocation="CenterScreen"
        Background="#E6E6E6"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Toolbar icon button (stays pressed) for pen / eraser -->
        <Style x:Key="ToolIconRadio" TargetType="RadioButton">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#444444"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEEEEE"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DCE9F9"/>
                                <Setter Property="Foreground" Value="#1A73E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toolbar icon button (momentary) for actions -->
        <Style x:Key="ToolIconButton" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#444444"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEEEEE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DCDCDC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#BBBBBB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Colour swatch (radio) -->
        <Style x:Key="ColorSwatch" TargetType="RadioButton">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="SwatchBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="#CCCCCC" BorderThickness="1"
                                    CornerRadius="4"/>
                            <Border x:Name="SelectionRing"
                                    BorderBrush="#1A73E8" BorderThickness="2"
                                    CornerRadius="5" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SelectionRing" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SelectionRing" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SelectionRing" Property="BorderBrush" Value="#88BBEE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Template thumbnail (radio) -->
        <Style x:Key="TemplateThumb" TargetType="RadioButton">
            <Setter Property="Width" Value="54"/>
            <Setter Property="Height" Value="70"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="ThumbBorder"
                                    BorderBrush="#CCCCCC" BorderThickness="1"
                                    CornerRadius="4"
                                    Background="{TemplateBinding Background}"/>
                            <Border x:Name="SelectionRing"
                                    BorderBrush="#1A73E8" BorderThickness="2"
                                    CornerRadius="5" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SelectionRing" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Preview patterns for the 4 templates -->
        <DrawingBrush x:Key="PreviewBlank" TileMode="None">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="White">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,54,70"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <DrawingBrush x:Key="PreviewRuled" TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="White">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,10,10"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#888888" Thickness="0.5"/>
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <LineGeometry StartPoint="0,9.75" EndPoint="10,9.75"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <DrawingBrush x:Key="PreviewGrid" TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="White">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,10,10"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#888888" Thickness="0.5"/>
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="0,9.75" EndPoint="10,9.75"/>
                                <LineGeometry StartPoint="9.75,0" EndPoint="9.75,10"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <DrawingBrush x:Key="PreviewDot" TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="White">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,10,10"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#888888">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="5,5" RadiusX="1" RadiusY="1"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New" Executed="New_Executed"/>
        <CommandBinding Command="ApplicationCommands.Open" Executed="Open_Executed"/>
        <CommandBinding Command="ApplicationCommands.Save" Executed="Save_Executed"/>
        <CommandBinding Command="ApplicationCommands.SaveAs" Executed="SaveAs_Executed"/>
        <CommandBinding Command="ApplicationCommands.Undo" Executed="Undo_Executed" CanExecute="Undo_CanExecute"/>
        <CommandBinding Command="ApplicationCommands.Redo" Executed="Redo_Executed" CanExecute="Redo_CanExecute"/>
    </Window.CommandBindings>

    <DockPanel>
        <!-- Top toolbar -->
        <Border DockPanel.Dock="Top" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <DockPanel Margin="8,6">

                <!-- Right side: palette, add, file menu -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PaletteButton"
                            Style="{StaticResource ToolIconButton}"
                            Content="&#xE790;"
                            ToolTip="Colours and page style"
                            Click="PaletteButton_Click"/>
                    <Rectangle Width="1" Margin="6,6" Fill="#DDDDDD"/>
                    <Button x:Name="AddMenuButton"
                            Style="{StaticResource ToolIconButton}"
                            Content="&#xE710;"
                            ToolTip="Add"
                            Click="MenuButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Add Text" Click="AddText_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="SaveMenuButton"
                            Style="{StaticResource ToolIconButton}"
                            Content="&#xE700;"
                            ToolTip="File menu"
                            Click="MenuButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="New" Command="ApplicationCommands.New"/>
                                <MenuItem Header="Open..." Command="ApplicationCommands.Open"/>
                                <Separator/>
                                <MenuItem Header="Save" Command="ApplicationCommands.Save"/>
                                <MenuItem Header="Save As..." Command="ApplicationCommands.SaveAs"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>

                <!-- Left side: tools -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="PenButton" Style="{StaticResource ToolIconRadio}" GroupName="Tools"
                                 Content="&#xE70F;" ToolTip="Pen" Click="PenButton_Click"/>
                    <RadioButton x:Name="EraserButton" Style="{StaticResource ToolIconRadio}" GroupName="Tools"
                                 Content="&#xE75C;" ToolTip="Eraser" Click="EraserButton_Click"/>
                    <Button x:Name="ClearButton" Style="{StaticResource ToolIconButton}"
                            Content="&#xE74D;" ToolTip="Clear page" Click="ClearButton_Click"/>
                    <Rectangle Width="1" Margin="8,6" Fill="#DDDDDD"/>
                    <Button x:Name="UndoButton" Style="{StaticResource ToolIconButton}"
                            Content="&#xE7A7;" ToolTip="Undo" Command="ApplicationCommands.Undo"/>
                    <Button x:Name="RedoButton" Style="{StaticResource ToolIconButton}"
                            Content="&#xE7A6;" ToolTip="Redo" Command="ApplicationCommands.Redo"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Right side panel (hidden by default) -->
        <Border x:Name="SidePanel" DockPanel.Dock="Right" Width="320"
                Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1,0,0,0"
                Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18,16">

                    <TextBlock Text="Background Colour" FontWeight="SemiBold" FontSize="13"
                               Foreground="#333333" Margin="0,0,0,6"/>
                    <UniformGrid Columns="4" Rows="2">
                        <RadioButton x:Name="ColorWhite" Style="{StaticResource ColorSwatch}" GroupName="BgColor"
                                     Background="#FFFFFF" ToolTip="White" Click="ColorSwatch_Click" Tag="#FFFFFF"/>
                        <RadioButton x:Name="ColorCream" Style="{StaticResource ColorSwatch}" GroupName="BgColor"
                                     Background="#FAF6E3" ToolTip="Cream" Click="ColorSwatch_Click" Tag="#FAF6E3"/>
                        <RadioButton x:Name="ColorLightGray" Style="{StaticResource ColorSwatch}" GroupName="BgColor"
                                     Background="#EEEEEE" ToolTip="Light grey" Click="ColorSwatch_Click" Tag="#EEEEEE"/>
                        <RadioButton x:Name="ColorSage" Style="{StaticResource ColorSwatch}" GroupName="BgColor"
                                     Background="#DCE9D5" ToolTip="Sage" Click="ColorSwatch_Click" Tag="#DCE9D5"/>
                        <RadioButton x:Name="ColorSky" Style="{StaticResource ColorSwatch}" GroupName="BgColor"
                                     Background="#DCE4F2" ToolTip="Sky" Click="ColorSwatch_Click" Tag="#DCE4F2"/>
                        <RadioButton x:Name="ColorNavy" Style="{StaticResource ColorSwatch}" GroupName="BgColor"
                                     Background="#2C3E5C" ToolTip="Navy" Click="ColorSwatch_Click" Tag="#2C3E5C"/>
                        <RadioButton x:Name="ColorDarkGreen" Style="{StaticResource ColorSwatch}" GroupName="BgColor"
                                     Background="#1E4D3A" ToolTip="Dark green" Click="ColorSwatch_Click" Tag="#1E4D3A"/>
                        <RadioButton x:Name="ColorBlack" Style="{StaticResource ColorSwatch}" GroupName="BgColor"
                                     Background="#1A1A1A" ToolTip="Black" Click="ColorSwatch_Click" Tag="#1A1A1A"/>
                    </UniformGrid>

                    <TextBlock Text="Templates" FontWeight="SemiBold" FontSize="13"
                               Foreground="#333333" Margin="0,22,0,6"/>
                    <UniformGrid Columns="4">
                        <RadioButton x:Name="TemplateBlank" Style="{StaticResource TemplateThumb}" GroupName="Template"
                                     Background="{StaticResource PreviewBlank}" ToolTip="Blank"
                                     Click="TemplateButton_Click" Tag="Blank"/>
                        <RadioButton x:Name="TemplateRuled" Style="{StaticResource TemplateThumb}" GroupName="Template"
                                     Background="{StaticResource PreviewRuled}" ToolTip="Ruled"
                                     Click="TemplateButton_Click" Tag="Ruled"/>
                        <RadioButton x:Name="TemplateGrid" Style="{StaticResource TemplateThumb}" GroupName="Template"
                                     Background="{StaticResource PreviewGrid}" ToolTip="Grid"
                                     Click="TemplateButton_Click" Tag="Grid"/>
                        <RadioButton x:Name="TemplateDot" Style="{StaticResource TemplateThumb}" GroupName="Template"
                                     Background="{StaticResource PreviewDot}" ToolTip="Dot grid"
                                     Click="TemplateButton_Click" Tag="Dot"/>
                    </UniformGrid>

                    <TextBlock Text="Spacing" FontWeight="SemiBold" FontSize="13"
                               Foreground="#333333" Margin="0,22,0,6"/>
                    <ComboBox x:Name="SpacingCombo" Width="110" HorizontalAlignment="Left"
                              SelectionChanged="SpacingCombo_SelectionChanged">
                        <ComboBoxItem Content="20"/>
                        <ComboBoxItem Content="30"/>
                        <ComboBoxItem Content="40" IsSelected="True"/>
                        <ComboBoxItem Content="50"/>
                        <ComboBoxItem Content="60"/>
                    </ComboBox>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Bottom status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready. Draw with your pen or mouse."/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="VersionText" Foreground="Gray"/>
            </StatusBarItem>
        </StatusBar>

        <!-- The writing page -->
        <Border Margin="12" Background="White" BorderBrush="#B0B0B0" BorderThickness="1">
            <Grid>
                <Rectangle x:Name="PageBackground" Fill="White"/>
                <InkCanvas x:Name="InkArea"
                           Background="Transparent"
                           Stylus.IsPressAndHoldEnabled="False"
                           Stylus.IsFlicksEnabled="False"
                           StrokeCollected="InkArea_StrokeCollected"/>
            </Grid>
        </Border>

    </DockPanel>
</Window>
